/* день */
.day{position:relative;margin-top:30px}
.day .line{position:absolute;left:0;right:0;top:34px;height:2px;background:var(--line)}
.day .line i{position:absolute;left:0;top:0;height:100%;width:0;background:linear-gradient(90deg,var(--amber),var(--amber-l));transition:width 2.4s var(--ease);box-shadow:0 0 12px rgba(217,154,62,.6)}
