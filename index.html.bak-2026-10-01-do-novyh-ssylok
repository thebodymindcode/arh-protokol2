/* шкала привычки */
.habit{position:relative;padding:50px 0 10px}
.habit .track{height:14px;border-radius:7px;background:rgba(234,241,239,.08);position:relative;overflow:visible}
.habit .rng{position:absolute;left:0;top:0;height:100%;border-radius:7px;background:linear-gradient(90deg,rgba(79,179,169,.25),rgba(79,179,169,.55));width:0;transition:width 2s var(--ease)}
.in .habit .rng{width:100%}
.habit .med{position:absolute;top:-6px;height:26px;border-radius:6px;background:var(--amber);box-shadow:0 0 18px rgba(217,154,62,.7);opacity:0;transition:opacity .6s 1.6s}
.in .habit .med{opacity:1}
.habit .mk{position:absolute;top:72px;font-size:12.5px;color:var(--mute);transform:translateX(-50%);white-space:nowrap}
.habit .mk b{display:block;font-family:var(--ft);font-size:15px;color:var(--ink);font-weight:var(--hw)}
.habit .mk.a b{color:var(--amber-l)}
.habit .mk.x{opacity:0;transition:opacity .6s 1.8s}
.in .habit .mk.x{opacity:1}
.habit .old{position:absolute;top:0;font-size:12.5px;color:var(--rose);transform:translateX(-50%);white-space:nowrap}
.habit .old::after{content:"";position:absolute;left:50%;top:100%;width:1px;height:26px;background:var(--rose)}
.habit .mk:last-child{left:auto!important;right:0;transform:none;text-align:right}
.cstat{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:22px 0 4px}
.cstat div{padding:16px 14px;border-radius:14px;background:rgba(234,241,239,.05);border:1px solid var(--line)}
.cstat b{display:block;font-family:var(--ft);font-weight:var(--hw);font-size:30px;line-height:1;color:var(--ink);margin-bottom:8px}
.cstat b small{font-size:.5em;color:var(--rose)}
.cstat span{font-size:12.5px;color:var(--mute);line-height:1.35}
/* мозг v3 */
.brainwrap{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(28px,4vw,60px);align-items:center}
.brainbox{position:relative;border-radius:var(--r-lg);border:1px solid var(--line);background:radial-gradient(70% 70% at 50% 45%,rgba(79,179,169,.12),transparent 70%),linear-gradient(180deg,rgba(234,241,239,.03),transparent);padding:22px 22px 70px;overflow:hidden}
.brainbox canvas{width:100%;height:auto;display:block}
.labels{position:absolute;inset:22px 22px 70px;pointer-events:none}
.bl{position:absolute;transform:translate(-8px,-100%);font-size:12px;font-weight:700;letter-spacing:.04em;color:var(--ink);background:rgba(10,31,34,.85);border:1px solid rgba(240,194,122,.45);padding:5px 9px;border-radius:8px;white-space:nowrap;animation:blin .6s var(--ease) both}
.bl.ctl{border-color:rgba(143,214,206,.5)}
.bl.r{transform:translate(8px,-100%)}
.bl::after{content:"";position:absolute;left:8px;top:100%;width:1px;height:var(--h,26px);background:currentColor;opacity:.5}
.bl.r::after{left:auto;right:8px}
@keyframes blin{from{opacity:0;translate:0 6px}to{opacity:1}}
.meterbox{position:absolute;left:22px;right:22px;bottom:22px;display:flex;align-items:center;gap:14px;font-size:12.5px;color:var(--mute)}
.meter{flex:1;height:6px;border-radius:3px;background:rgba(234,241,239,.08);overflow:hidden}
.meter i{display:block;height:100%;width:0;border-radius:3px;background:linear-gradient(90deg,var(--teal),var(--amber-l));transition:width .4s}
.sw.v{flex-wrap:wrap}
/* внимание v3 */
.vnim{position:relative;display:flex;align-items:center;border-radius:var(--r-lg);border:1px solid var(--line);background:linear-gradient(180deg,rgba(234,241,239,.04),transparent);overflow:hidden;padding:0}
.vnim canvas{width:100%;height:auto;display:block}
.vnim .cnt{position:absolute;right:24px;top:20px;text-align:right}
.vnim .cnt b{display:block;font-family:var(--ft);font-weight:var(--hw);font-size:44px;line-height:1;color:var(--ink)}
.vnim .cnt span{font-size:13px;color:var(--mute)}
.vnim .lbl{position:absolute;left:24px;bottom:18px;font-size:13px;color:var(--mute)}
@media (max-width:1080px){.brainwrap{grid-template-columns:1fr}}
@media (max-width:680px){.bl{font-size:12px;padding:4px 7px;white-space:normal;max-width:170px;line-height:1.25;text-align:left;text-wrap:balance}.bl.r,.bl.b{text-align:right}.bl.l.b{text-align:left}.bl::after{height:calc(var(--h,26px) * .54)}.sw.v{display:grid;grid-template-columns:1fr 1fr;width:100%}.sw.v button:last-child{grid-column:1/-1}.sw.v button{padding-inline:10px}.brainbox{padding:14px 14px 62px}.labels{inset:14px 14px 62px}.meterbox{left:14px;right:14px;bottom:16px}.vnim .cnt b{font-size:34px}}
.lyudi{display:grid;grid-template-columns:repeat(25,1fr);gap:5px;margin-top:22px}
.lyudi i{aspect-ratio:1;border-radius:3px;background:var(--rose);opacity:.85;transition:opacity .6s,background .6s}
.lyudi i.g{opacity:.12;background:var(--ink)}
.bl.b{transform:translate(8px,0)}
.bl.b::after{top:auto;bottom:100%;left:auto;right:8px}
.bl.l.b{transform:translate(-8px,0)}.bl.l.b::after{left:8px;right:auto}
.vs-sw{display:flex;justify-content:center;margin-bottom:40px}
.vs-sw .sw{margin:0}
.vs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;perspective:1600px}
.vs-grid.two-col{grid-template-columns:repeat(2,1fr)}
.flip{position:relative;display:grid;transform-style:preserve-3d;transition:transform .8s var(--ease)}
.vs-grid.two .flip{transform:rotateY(180deg)}
.flip > div{grid-area:1/1;position:relative;backface-visibility:hidden;min-height:0;border-radius:22px;padding:26px 28px 28px;display:flex;flex-direction:column;gap:16px}
.flip .was{background:rgba(234,241,239,.04);border:1px solid var(--line)}
.flip .now{transform:rotateY(180deg);background:linear-gradient(160deg,rgba(217,154,62,.2),rgba(217,154,62,.05));border:1px solid rgba(217,154,62,.4)}
.flip > div::before{content:attr(data-t);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);order:1}
.flip .now::before{color:var(--amber-l)}
.flip .ik{position:static;margin:0;width:60px;height:60px;border-radius:18px;order:0}.flip .ik svg{width:30px;height:30px}
.flip .was .ik{background:rgba(234,241,239,.06);border-color:var(--line);color:var(--mute)}
.flip p{font-family:var(--ft);font-weight:var(--hw);letter-spacing:var(--ls);font-size:clamp(18px,1.55vw,22px);line-height:1.3;color:var(--ink);order:2;margin-top:auto}
.flip .was p{color:var(--body)}
.flip .now p{font-family:var(--fb);font-weight:500;letter-spacing:0;font-size:16.5px;line-height:1.5}
.vs-quote{margin-top:40px;display:grid;grid-template-columns:1fr 1fr;gap:22px}
.vs-quote .card{display:flex;flex-direction:column;justify-content:center}
.vs-quote .q{font-family:var(--ft);font-weight:var(--hw);letter-spacing:var(--ls);font-size:clamp(19px,1.6vw,22px);line-height:1.25;color:var(--ink);text-wrap:balance}
.nw{white-space:nowrap}
.devices{position:relative;height:clamp(420px,52vw,680px);margin:10px 0 50px;perspective:1800px}
.devices .lap{position:absolute;left:50%;top:0;translate:-50% 0;width:min(820px,84%)}
.lap .scr{background:#0B1618;border-radius:18px 18px 4px 4px;padding:10px;box-shadow:var(--sh)}
.lap .scr img{border-radius:8px;width:100%;aspect-ratio:1440/800;object-fit:cover;object-position:top}
.lap .base{height:14px;margin:0 -4%;background:linear-gradient(#C9D4D1,#A9B8B4);border-radius:0 0 16px 16px;position:relative}
.lap .base::before{content:"";position:absolute;left:50%;top:0;translate:-50% 0;width:16%;height:5px;border-radius:0 0 8px 8px;background:#8FA19D}
.devices .ph1{position:absolute;left:2%;bottom:0;width:min(230px,26%);transform:rotateY(14deg) rotateZ(-3deg);z-index:2}
.devices .ph2{position:absolute;right:2%;bottom:6%;width:min(230px,26%);transform:rotateY(-14deg) rotateZ(3deg);z-index:2}
.devices .phone{width:100%}
.feat{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.feat .card{padding:26px}
.feat h3{font-size:18px}
.feat p{font-size:14.5px;color:var(--mute)}
.gal{display:flex;gap:28px;overflow-x:auto;scroll-snap-type:x mandatory;padding:34px var(--pad) 40px;margin:0 calc(var(--pad)*-1);margin-right:calc(50% - 50vw);padding-right:max(var(--pad),calc(50vw - 50%));scrollbar-width:none}
.gal::-webkit-scrollbar{display:none}
.gal figure{scroll-snap-align:center;flex:none;width:min(270px,68vw)}
