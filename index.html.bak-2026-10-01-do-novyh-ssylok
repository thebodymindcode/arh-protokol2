.day ol{list-style:none;display:grid;grid-template-columns:repeat(6,1fr);gap:16px;counter-reset:d}
.day li{position:relative;padding-top:80px;opacity:0;transform:translateY(16px);transition:.7s var(--ease)}
.in .day li{opacity:1;transform:none}
.in .day li:nth-child(2){transition-delay:.14s}.in .day li:nth-child(3){transition-delay:.28s}.in .day li:nth-child(4){transition-delay:.42s}.in .day li:nth-child(5){transition-delay:.56s}.in .day li:nth-child(6){transition-delay:.7s}
.day li .ik{position:absolute;top:8px;left:0;margin:0;background:var(--bg2);border-color:rgba(217,154,62,.5)}
